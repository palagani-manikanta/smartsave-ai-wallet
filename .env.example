# SmartSave AI Wallet - environment template
# Copy to server/.env, apps/web/.env.local and .env (docker-compose), then fill in your own values.
# Never commit real keys.

# --- Database (Express API + Wallet MCP) ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smartsave?schema=public

# --- Clerk authentication (https://dashboard.clerk.com -> API Keys) ---
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# --- Next.js client ---
NEXT_PUBLIC_API_URL=/api/v1

# --- AI Verification MCP (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Optional ---
PORT=5000
LOG_LEVEL=info
NODE_ENV=development
